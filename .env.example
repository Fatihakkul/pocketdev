BOT_TOKEN=
WORKSPACE_ROOT=./workspace

# Interface language / Arayüz dili: en (default) or tr
# LOCALE=tr

# Sahiplik: normalde BOŞ bırakılır.
# Bot ilk çalıştığında konsola tek seferlik bir kod basıyor; Telegram'dan
# `/claim <kod>` yazınca sahip olarak kaydediliyorsun. Kendi sayısal Telegram
# id'ni öğrenmen gerekmiyor.
# Sahipliği sabitlemek istersen buraya sayısal id yazabilirsin; verildiğinde
# `/claim` devre dışı kalır.
# ALLOWED_USER_ID=

# OTA kurulum linkini hangi tunnel'ın servis edeceği.
# Varsayılan tailscale. cloudflared yedektir ve kota sınırına takılabilir.
# OTA_TUNNEL=cloudflared

# --- App Store Connect API key (optional / isteğe bağlı) ---
# Lets xcodebuild create a missing ad-hoc provisioning profile by itself.
# Eksik ad-hoc profili xcodebuild'in kendisine ürettirir.
#
# The key's role MUST be `Admin` — `App Manager` fails with a misleading
# "No profiles were found" error. See README.
# Anahtarın rolü `Admin` OLMAK ZORUNDA — `App Manager` yanıltıcı bir
# "profil bulunamadı" hatası verir. Bkz. README.
#
# ASC_KEY_ID=XXXXXXXXXX
# ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Defaults to ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8
# ASC_KEY_PATH=
